<?xml version="1.0" encoding="UTF-8"?>
<!--
    IIS equivalent of the Apache rules in public/.htaccess, for the Windows
    Server deployment (docs/setup.md §10). Requires the IIS URL Rewrite
    module; without it IIS ignores the <rewrite> section entirely and every
    URL except / returns 404.

    Apache installations are unaffected — .htaccess is still there and still
    what mod_rewrite reads.
-->
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <!--
                    Authorization headers: IIS/FastCGI does not pass these
                    through to PHP on its own, so Filament's session and any
                    API token auth would silently see no credentials.
                -->
                <rule name="Authorization header" stopProcessing="false">
                    <match url=".*" />
                    <conditions>
                        <add input="{HTTP_AUTHORIZATION}" pattern=".+" />
                    </conditions>
                    <serverVariables>
                        <set name="HTTP_AUTHORIZATION" value="{HTTP_AUTHORIZATION}" />
                    </serverVariables>
                    <action type="None" />
                </rule>

                <!-- Redirect trailing slashes if not a folder -->
                <rule name="Trailing slash" stopProcessing="true">
                    <match url="^(.*)/$" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                    </conditions>
                    <action type="Redirect" redirectType="Permanent" url="{R:1}" />
                </rule>

                <!-- Send everything that is not a real file to the front controller -->
                <rule name="Front controller" stopProcessing="true">
                    <match url="^" ignoreCase="false" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php" />
                </rule>
            </rules>
        </rewrite>

        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
            </files>
        </defaultDocument>

        <!--
            Options -Indexes: never serve a generated directory listing.
        -->
        <directoryBrowse enabled="false" />

        <!--
            The .htaccess "deny all" on dotfiles. .env is not under public/,
            but a mis-set site root that pointed IIS at the application root
            rather than public/ would otherwise serve it in plain text.
        -->
        <security>
            <requestFiltering>
                <hiddenSegments>
                    <add segment=".env" />
                    <add segment=".git" />
                    <add segment="storage" />
                    <add segment="vendor" />
                </hiddenSegments>
            </requestFiltering>
        </security>
    </system.webServer>
</configuration>
